# REzeBlog Next.js 개발용 Dockerfile
# 작성일: 2026-04-18
# 특징: 개발 환경 최적화 (hot reload 지원)

FROM node:20-alpine

# 작업 디렉토리 설정
WORKDIR /app

# 패키지 파일 복사 (캐시 활용)
COPY package*.json ./

# 의존성 설치
RUN npm ci

# 개발 서버 실행
EXPOSE 3000

ENV NODE_ENV=development
ENV PORT=3000
ENV WATCHPACK_POLLING=true

CMD ["npm", "run", "dev"]
