# REzeBlog 환경 변수 설정
# 이 파일을 복사해서 .env.local로 사용하세요

# PostgreSQL 데이터베이스 연결
DATABASE_URL=postgresql://username:password@localhost:5432/rezeblog

# 또는 개발 환경용 로컬 설정
# DATABASE_URL=postgresql://localhost:5432/rezeblog

# Next.js 설정
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO 설정
NEXT_PUBLIC_SITE_NAME=REzeBlog
NEXT_PUBLIC_SITE_DESCRIPTION=인터랙티브 스토리텔링 블로그

# ============================================
# Naver Search Advisor API
# https://searchadvisor.naver.com/ 에서 API 키 발급
# ============================================
NAVER_API_KEY=your_naver_api_key_here
NAVER_API_SECRET=your_naver_api_secret_here
NAVER_SITE_URL=https://rezeblog.vercel.app

# ============================================
# Google Search Console API (Service Account)
# https://console.cloud.google.com/apis/credentials 에서 발급
# ============================================
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=your_base64_encoded_service_account_json_here
SEARCH_CONSOLE_PROPERTY=https://rezeblog.vercel.app/

# 어드민 인증
ADMIN_PASSWORD=your_secure_admin_password_here

# 기본 포트 (선택사항)
# PORT=3000
