# REzeBlog 환경 변수 설정 예시
# 작성일: 2026-04-20
# 사용법: 이 파일을 .env로 복사하고 실제 값을 채워넣으세요
# ⚠️ 절대 .env 파일을 Git에 커밋하지 마세요!

# ============================================
# 데이터베이스 설정
# ============================================
POSTGRES_USER=rezeblog
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=rezeblog
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ============================================
# Next.js 설정
# ============================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# 관리자 인증
# ============================================
ADMIN_PASSWORD=your_admin_password_here

# ============================================
# API 보안
# ============================================
API_SECRET_KEY=your_api_secret_key_here

# ============================================
# Google Search Console API
# ============================================
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
GOOGLE_SITE_URL=https://rezeblog.vercel.app

# ============================================
# Naver Search Advisor API
# ============================================
NAVER_API_KEY=your_naver_api_key
NAVER_API_SECRET=your_naver_api_secret
NAVER_SITE_URL=https://rezeblog.vercel.app
