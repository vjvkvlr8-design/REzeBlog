# REzeBlog 환경 변수 설정
# 이 파일을 복사해서 .env.local로 사용하세요

# PostgreSQL 데이터베이스 연결
DATABASE_URL=postgresql://username:password@localhost:5432/rezeblog

# 또는 개발 환경용 로컬 설정
# DATABASE_URL=postgresql://localhost:5432/rezeblog

# Next.js 설정
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO 설정
NEXT_PUBLIC_SITE_NAME=REzeBlog
NEXT_PUBLIC_SITE_DESCRIPTION=인터랙티브 스토리텔링 블로그

# 기본 포트 (선택사항)
# PORT=3000
